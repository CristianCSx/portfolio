---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const base = lang === 'en' ? '/en' : '';
const home = `${base}/#top`;
const experience = `${base}/#experience`;
const about = `/#about-me`;

const projects = lang === 'en'
  ? '/en/projects'
  : '/es/projects';
---

<header class="fixed z-10 flex justify-center items-center mt-4 lg:w-auto p-2 mx-auto bg-white/10 backdrop-blur-sm rounded-xl text-sm">
	<nav class="flex flex-wrap justify-center">
		<a class="rounded px-4 py-2 text-white/80 hover:text-white hover:bg-white/20" href={home}>
			{t('nav.button01')}
		</a>
		<a class="rounded px-4 py-2 text-white/80 hover:text-white hover:bg-white/20" href={experience}>
			{t('nav.button02')}
		</a>
		<a class="rounded px-4 py-2 text-white/80 hover:text-white hover:bg-white/20" href="#about-me">
			{t('nav.button05')}
		</a>
		<a class="rounded px-4 py-2 text-white/80 hover:text-white hover:bg-white/20" href={projects}>
			{t('nav.button04')}
		</a>
	</nav>
</header>
