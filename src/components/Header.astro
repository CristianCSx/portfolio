---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

let route = '/es';
if(lang === 'en') route =  '/' + lang;
---

<header class="fixed z-10 flex justify-center items-center mt-4 px-4 py-3 lg:w-auto mx-auto bg-white/10 backdrop-blur-sm rounded-xl text-sm">
	<nav class="flex flex-wrap justify-center gap-x-4 gap-y-2">
		<a class="text-white/80 hover:text-white" href=`${route}/#top`>{t('nav.button01')}</a>
		<a class="text-white/80 hover:text-white" href=`${route}/#experience`>{t('nav.button02')}</a>
		<a class="text-white/80 hover:text-white" href=`${route}/#tech-stack`>{t('nav.button03')}</a>
		<a class="text-white/80 hover:text-white" href=`${route}/projects`>{t('nav.button04')}</a>
		<a class="text-white/80 hover:text-white" href="#about-me">{t('nav.button05')}</a>
	</nav>
</header>
