---
const path = Astro.url.pathname;

const isEnglish = path.startsWith('/en');
const isSpanish = path.startsWith('/es');

// quitar prefijo de idioma
let rest = path.replace(/^\/(en|es)/, '');
if (!rest.startsWith('/')) rest = '/';

// detectar raíz real (sin idioma)
const isRoot = path === '/';

// construir nuevo path
let newPath;

if (isRoot) {
  newPath = '/en';
} else if (isEnglish) {
  newPath = rest === '/' ? '/' : `/es${rest}`;
} else {
  // español o raíz implícita
  newPath = rest === '/' ? '/en' : `/en${rest}`;
}
---

<a
	href={newPath}
	class="fixed bottom-6 right-6 z-50 flex items-center gap-2 rounded px-4 py-2 bg-white/10 backdrop-blur-sm font-bold transition hover:scale-105"
>
	{isEnglish ? 'ES' : 'EN'}

	{isEnglish ? (
		<img src="/images/flags/es.svg" alt="ES" class="w-5 h-5" />
	) : (
		<img src="/images/flags/gb.svg" alt="EN" class="w-5 h-5" />
	)}
</a>
