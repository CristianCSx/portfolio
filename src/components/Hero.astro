---
import { Image } from "astro:assets";
import Badge from "./Badge.astro";
import Experience from "./Experience.astro";
import SectionContainer from "./SectionContainer.astro";
---

<main class="sm:mx-5">
	<SectionContainer class="pt-44 pb-24">
		<div class="pb-8">
			<div class="flex flex-col sm:flex-row gap-4 items-center">
				<Image
					class="rounded-full"
					src="/my-photo.jpg"
					alt="cristian"
					width={120}
					height={120}
					loading={"eager"}
				/>
				<h1 class="text-white text-3xl sm:text-5xl font-bold flex flex-wrap gap-x-3 pb-4">Hola, soy
					<span class="bg-linear-to-r from-[#B81CE8] to-[#57C1CF] bg-clip-text text-transparent">
						Cristian
					</span>
					👋
				</h1>
			</div>
		</div>
		
		<h2 class="text-2xl text-white/80 [&>strong]:text-[#aed1c4] [&>strong]:opacity-100">
			Ingeniero de Software y Sistemas Informáticos. Especializado en <strong>Desarrollo de aplicaciones Web</strong> e <strong>Inteligencia Artificial</strong>. De Salamanca, España.
		</h2>

		<div class="flex flex-wrap gap-3 py-4 w-full">
			<Badge url="https://www.linkedin.com/in/cristian-castillo-salguero/" bg_color="#162556" text_color="#fff" border_color="#1c398e">Linkedin</Badge>
			<Badge url="https://github.com/CristianCSx" bg_color="#1e2939" text_color="#fff" border_color="#364153">Github</Badge>
			<Badge url="https://x.com/cristiancsdev" bg_color="#101828" text_color="#fff" border_color="#28364a">X / Twitter</Badge>
			<Badge url="mailto:cristiancsdev@gmail.com" bg_color="#424242" text_color="#fff" border_color="#5e5e5e">cristiancsdev@gmail.com</Badge>
		</div>
	</SectionContainer>
	<SectionContainer id="experience">
		<h2 class="text-2xl font-semibold mb-6">Experiencia laboral</h2>
		<Experience />
	</SectionContainer>
</main>
