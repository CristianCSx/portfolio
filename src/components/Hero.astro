---
import { Image } from "astro:assets";
import Experience from "./Experience.astro";
import SectionContainer from "./SectionContainer.astro";
import BadgesContainer from "./BadgesContainer.astro";
import TechStack from "./TechStack.astro";
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<main class="sm:mx-5">
	<SectionContainer class="pt-44 pb-24 max-w-4xl px-4">
		
		<div class="pb-8">
			<div class="flex flex-col sm:flex-row gap-4 items-center">
				<Image
					class="rounded-full"
					src='/images/profile.jpg'
					alt="cristian"
					width={120}
					height={120}
					loading={"eager"}
				/>
				<h1 class="text-white text-3xl sm:text-5xl font-bold flex flex-wrap gap-x-3 pb-4">{t('hero.title02')}
					<span class="bg-linear-to-r from-[#fa3777] to-[#dd50ef] bg-clip-text text-transparent">
						{t('hero.title03')}
					</span>
					👋
				</h1>
			</div>
		</div>
		
		<h2 class="text-2xl text-white/80 [&>strong]:text-[#e84f82] [&>strong]:opacity-100 prose max-w-none">
			{t('hero.subtitle01')} <strong>{t('hero.subtitle02')}</strong> {t('hero.subtitle03')} <strong>{t('hero.subtitle04')}</strong> {t('hero.subtitle05')}
		</h2>

		<BadgesContainer />

	</SectionContainer>

	<SectionContainer id="experience" class="pt-24 px-4">
		<div class="flex flex-col mb-6">
			<div class="flex items-center">
				<svg xmlns="http://www.w3.org/2000/svg" class="mt-[-5px] mr-[10px]" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dumbbell-icon lucide-dumbbell"><path d="M17.596 12.768a2 2 0 1 0 2.829-2.829l-1.768-1.767a2 2 0 0 0 2.828-2.829l-2.828-2.828a2 2 0 0 0-2.829 2.828l-1.767-1.768a2 2 0 1 0-2.829 2.829z"/><path d="m2.5 21.5 1.4-1.4"/><path d="m20.1 3.9 1.4-1.4"/><path d="M5.343 21.485a2 2 0 1 0 2.829-2.828l1.767 1.768a2 2 0 1 0 2.829-2.829l-6.364-6.364a2 2 0 1 0-2.829 2.829l1.768 1.767a2 2 0 0 0-2.828 2.829z"/><path d="m9.6 14.4 4.8-4.8"/></svg>
				<h2 class="text-2xl font-semibold mb-1">{t('hero.text01')}</h2>
			</div>
			<div class="h-0.5 w-40 bg-linear-to-r from-[#e84f82] to-transparent"></div>
		</div>
		<Experience />
	</SectionContainer>

	<SectionContainer id="tech-stack" class="pt-24 pb-24 max-w-4xl px-4">
		<div class="flex flex-col mb-6">
			<div class="flex items-center">
				<svg xmlns="http://www.w3.org/2000/svg" class="mt-[-5px] mr-[10px]" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wrench-icon lucide-wrench"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/></svg>
				<h2 class="text-2xl font-semibold mb-1">Teck Stack</h2>
			</div>
			
			<div class="h-0.5 w-40 bg-linear-to-r from-[#e84f82] to-transparent"></div>
		</div>
		<TechStack />
	</SectionContainer>
</main>
