---
import { Image } from "astro:assets";
import Experience from "./Experience.astro";
import SectionContainer from "./SectionContainer.astro";
import BadgesContainer from "./BadgesContainer.astro";
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<main class="sm:mx-5">
	<SectionContainer class="pt-44 pb-24 max-w-4xl px-4">
		
		<div class="pb-8">
			<div class="flex flex-col sm:flex-row gap-4 items-center">
				<Image
					class="rounded-full"
					src='/images/profile.jpg'
					alt="cristian"
					width={120}
					height={120}
					loading={"eager"}
				/>
				<h1 class="text-white text-3xl sm:text-5xl font-bold flex flex-wrap gap-x-3 pb-4">{t('hero.title02')}
					<span class="bg-linear-to-r from-[#B81CE8] to-[#57C1CF] bg-clip-text text-transparent">
						{t('hero.title03')}
					</span>
					👋
				</h1>
			</div>
		</div>
		
		<h2 class="text-2xl text-white/80 [&>strong]:text-[#aed1c4] [&>strong]:opacity-100 prose max-w-none">
			{t('hero.subtitle01')} <strong> {t('hero.subtitle02')} </strong> {t('hero.subtitle03')}  <strong> {t('hero.subtitle04')} </strong>{t('hero.subtitle05')}
		</h2>

		<BadgesContainer />

	</SectionContainer>

	<SectionContainer id="experience" class="pt-24 px-4">
		<div class="flex flex-col mb-6">
			<h2 class="text-2xl font-semibold mb-1">Experiencia</h2>
			<div class="h-0.5 w-40 bg-linear-to-r from-[#6be9fa]/70 to-transparent"></div>
		</div>
		<Experience />
	</SectionContainer>

	<SectionContainer id="tech-stack" class="pt-24 pb-24 max-w-4xl px-4">tech-stack</SectionContainer>
	</SectionContainer>
</main>
