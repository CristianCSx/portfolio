---
import { getLangFromUrl } from '../i18n/utils';
import ExperienceItem from "./ExperienceItem.astro";
import experienceEs from "@/data/es/experience.json";
import experienceEn from "@/data/en/experience.json";

const lang = getLangFromUrl(Astro.url);

let experience = experienceEs;
if(lang === 'en') experience = experienceEn;

---

<div class="w-full max-w-4xl mx-auto px-4">
	<ol class="relative border-s border-default pl-4 sm:pl-0">               
		{
			experience.map(experience => (
				<li class="mb-10 ms-4">
					<ExperienceItem {...experience} />
				</li>
			))
		}
	</ol>
</div>
