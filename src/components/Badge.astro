---
interface Props {
	url: string,
	text: string
	bg_color: string,
	text_color: string,
	border_color: string
}

const { url = "#", text, bg_color, text_color, border_color} = Astro.props;
---

<a 
	href={url}
	target="_blank" 
	rel="noopener noreferrer" 
	class="badge break-all inline-flex border items-center px-2 py-1 text-sm rounded-full font-semibold text-nowrap min-w-[60px] justify-center transition duration-200"
	style={`--bg: #${bg_color}; --text:#${text_color}; --border:#${border_color}`}
>
	{text}
</a>

<style>
	.badge {
		background-color: var(--bg);
		color: var(--text);
		border-color: var(--border);
	}

	.badge:hover {
		background-color: var(--text);
		color: var(--bg);
		border-color: var(--bg);
	}
</style>
