---
import { Image } from "astro:assets";
import SectionContainer from "@/components/SectionContainer.astro";
import Layout from "@/layouts/Layout.astro";
import TechnologiesContainer from "@/components/TechnologiesContainer.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projectsEn");

---

<Layout title="Projects">

	<main class="sm:mx-5">
			<SectionContainer class="mt-44 mb-24 max-w-4xl px-5 sm:px-10 md:px-20 lg:px-4">
				{
					projects.map(project => {
						const { id, data } = project;
						const { title, technologies, image, description } = data;

						return (
							<div class="flex flex-col lg:flex-row lg:mb-20 mt-20 sm:mt-20 md:mt-10">
								<div class="flex items-start lg:w-[450px] lg:min-w-[450px]">
									<div class="relative overflow-hidden rounded-xl w-full">
										<a href={`/en/projects/${id}`}>
											<Image 
											src={`/images/${image}`}
											transition:name={`img-${id}`}
											alt={title}
											width={450} 
											height={250} 
											loading="eager"
											class="w-full h-auto object-contain rounded-xl transition-transform duration-500 hover:scale-110"
											/>
										</a>
									</div>
								</div>

								<div class="flex flex-col flex-1 mt-5 mb-5 lg:mt-0 lg:ml-10 md:mb-5">
									<div class="flex flex-col gap-y-2 font-extralight opacity-85">
										<h1 transition:name={`title-${id}`} class="text-2xl font-bold">{title}</h1>
										<TechnologiesContainer className="" transition:name={`techs-${id}`} technologies={technologies} />
										<p class="text-justify prose max-w-none dark:prose-invert">{description}</p>
									</div>
								</div>
							</div>
						);
					})
				}
			</SectionContainer>
	</main>
</Layout>
