---
import Layout from "../../../layouts/Layout.astro";
import SectionContainer from "../../../components/SectionContainer.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import TechnologiesContainer from "../../../components/TechnologiesContainer.astro";

export async function getStaticPaths () {
	const projectsEs = await getCollection("projectsEs");
	const projectsEn = await getCollection("projectsEn");

	return [
		...projectsEs.map(project => ({
			params: {
				lang: 'es',
				id: project.id
			},
			props: { project }
		})),

		...projectsEn.map(project => ({
			params: {
				lang: 'en',
				id: project.id
			},
			props: { project }
		}))
	];
};

const { project } = Astro.props;
const { data, id } = project;
const { title, technologies, image } = data;

const { Content } = await render(project);
---

<Layout title={title}>
	<SectionContainer class="mt-44 mb-24 max-w-4xl px-5 sm:px-10 md:px-20 lg:px-4">
		<div class="">
			<div class="flex flex-col">
				<div class="">
					<h1 transition:name={`title-${id}`} class="font-bold text-4xl mb-8">{title}</h1>
				</div>
				<div class="w-full aspect-video overflow-hidden rounded-xl">
					<Image 
						src={`/images/${image}`}
						alt={title}
						transition:name={`img-${id}`}
						width={1920}
						height={1080}
						class="object-cover object-top-left w-full h-full"
						loading="eager"
					/>
				</div>

				<TechnologiesContainer transition:name={`techs-${id}`} className="mt-10" technologies={technologies} />

				<div class="mt-10 prose dark:prose-invert max-w-none">
					<Content />
				</div>
			</div>
		</div>
	</SectionContainer>
</Layout>
